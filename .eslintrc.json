{
  "extends": "athom/homey-app",
  "settings": {
    "import/resolver": {
      "typescript": {},
      "node": {
        "extensions": [".js", ".ts"]
      }
    }
  },
  "rules": {
    "import/extensions": [
      "error",
      "ignorePackages",
      {
        "js": "never",
        "ts": "never"
      }
    ],
    "node/no-missing-import": [
      "error",
      {
        "tryExtensions": [".js", ".ts", ".json"],
        "allowModules": ["homey"]
      }
    ]
  }
}