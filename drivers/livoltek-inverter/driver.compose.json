{
  "name": {
    "en": "Livoltek Inverter"
  },
  "class": "other",
  "capabilities": [
    "measure_battery_soc",
    "measure_power_load",
    "measure_power_grid_import",
    "measure_power_battery_charge",
    "measure_power_battery_consumption",
    "alarm_grid",
    "battery_status"
  ],
  "platforms": [
    "local"
  ],
  "connectivity": [
    "cloud"
  ],
  "images": {
    "small": "{{driverAssetsPath}}/images/livoltek-small.png",
    "large": "{{driverAssetsPath}}/images/livoltek-large.png",
    "xlarge": "{{driverAssetsPath}}/images/livoltek-xlarge.png"
  },
  "icon": "{{driverAssetsPath}}/icon.svg",
  "pair": [
    {
      "id": "select_region"
    },
    {
      "id": "login_credentials"
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "prev": "login_credentials",
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "repair": [
    {
      "id": "login_credentials"
    }
  ],
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Diagnostics"
      },
      "children": [
        {
          "id": "debug_logging",
          "type": "checkbox",
          "label": {
            "en": "Debug logging"
          },
          "value": false,
          "hint": {
            "en": "Log full API responses and per-capability details. Credentials and tokens are never logged."
          }
        }
      ]
    }
  ]
}
